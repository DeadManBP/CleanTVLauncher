<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer tile: banner art (icon fallback) with the app name underneath.
     Same red focus ring as the dock tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_focus"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/drawer_app_banner"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/drawer_app_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
