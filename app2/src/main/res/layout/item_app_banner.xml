<?xml version="1.0" encoding="utf-8"?>
<!-- Dock tile for a real app: its wide banner art, edge to edge.
     The 3dp padding lets the red focus ring (the tile background,
     @drawable/app_focus) show around the banner, and clipToOutline
     in code trims the banner's square corners to the ring's curve. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/app_focus"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="3dp">

    <ImageView
        android:id="@+id/app_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

</LinearLayout>
