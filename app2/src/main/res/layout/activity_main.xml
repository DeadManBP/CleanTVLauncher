<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper_gradient">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wallpaper_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:background="#80000000"
        android:visibility="gone" />

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="28dp"
        android:layout_marginStart="40dp"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/clock"
        android:layout_marginStart="40dp"
        android:layout_marginTop="2dp"
        android:textColor="#D8D8D8"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/now_playing_panel"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/hero_card"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/weather_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/now_playing_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/media_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="|◀"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/dock_pill"
            android:contentDescription="Previous track"
            android:nextFocusLeft="@id/media_previous"
            android:nextFocusRight="@id/media_play_pause" />

        <TextView
            android:id="@+id/media_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/dock_pill"
            android:contentDescription="Play or pause"
            android:nextFocusLeft="@id/media_previous"
            android:nextFocusRight="@id/media_next" />

        <TextView
            android:id="@+id/media_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="▶|"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/dock_pill"
            android:contentDescription="Next track"
            android:nextFocusLeft="@id/media_play_pause"
            android:nextFocusRight="@id/media_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weather_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="40dp"
        android:orientation="vertical"
        android:gravity="end">

    <LinearLayout
        android:id="@+id/weather_widget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="@drawable/weather_panel">

        <TextView
            android:id="@+id/weather_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weather_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weather loading"
                android:textColor="#D8E0EA"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/weather_highlow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H --°  L --°"
                android:textColor="#B9C6D6"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/network_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:background="@drawable/weather_panel"
        android:text="↓ -- KB/s   ↑ -- KB/s"
        android:textColor="#D8E0EA"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center_vertical" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/hero_card"
        android:layout_width="440dp"
        android:layout_height="162dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="42dp"
        android:background="@drawable/hero_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/hero_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW SELECTED"
            android:textColor="#E45A6B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <ImageView
            android:id="@+id/hero_banner"
            android:layout_width="380dp"
            android:layout_height="88dp"
            android:layout_marginTop="3dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/hero_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:includeFontPadding="false"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/dock_scroll"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="76dp"
        android:background="@drawable/dock_pill"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/app_dock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal" />

    </HorizontalScrollView>

</RelativeLayout>