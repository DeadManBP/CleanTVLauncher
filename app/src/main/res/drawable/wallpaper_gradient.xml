<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gunmetal gradient, top to bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#050506"
                android:startColor="#1B1B20"
                android:type="linear" />
        </shape>
    </item>
    <!-- Blood-red glow, top right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.05"
                android:endColor="#00000000"
                android:gradientRadius="900dp"
                android:startColor="#4A0E16"
                android:type="radial" />
        </shape>
    </item>
    <!-- Cold blue glow, bottom left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.05"
                android:centerY="1.0"
                android:endColor="#00000000"
                android:gradientRadius="700dp"
                android:startColor="#0E1B2E"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
